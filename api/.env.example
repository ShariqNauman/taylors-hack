# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# Optional (for AI Copilot & Weekly Report generation)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# Optional (for pgvector knowledge bank embeddings)
OPENAI_API_KEY=sk-proj-xxx

# Server Port (optional, default 8000)
PORT=8000
CORS_ORIGINS=*
