# EarlyEye dashboard — deployment environment
# Copy to .env.local for local work. On Vercel set these in Project → Settings →
# Environment Variables. Nothing here is a model key: the Anthropic key lives on
# the API (Render) and no frontend code path ever reads one.

# ── Deployed demo (Vercel): set EE_API_URL only ──────────────────────────────
# Server-side only, never inlined into the browser bundle. The handover brief is
# forwarded to the real API so the deployed site gets Claude's wording; every
# other screen stays on public/mock/*.json.
EE_API_URL=https://earl-eye-backend.onrender.com

# ── Read the dashboard's data from the API instead of the mock ───────────────
# Leave BOTH unset for the deployed demo. The API is seeded with a different
# site — its events name cameras (CAM-ASR-03, CAM-CPK-01, …) that the mock
# camera wall and the 3D campus do not have — so turning this on puts incidents
# on screen with nowhere to show them. Turn it on only against an API seeded
# from the same site as public/mock.
# NEXT_PUBLIC_API_URL=https://earl-eye-backend.onrender.com
# NEXT_PUBLIC_API_RESOURCES=events,site,cameras,plan,hotspots,proof

# ── On-site demo laptop: the webcam edge ─────────────────────────────────────
# NEXT_PUBLIC_EDGE_URL=http://127.0.0.1:8765

# ── Web Push (optional; the phone alarm works without it while the app is open)
# Generate with: python api/scripts/gen_vapid.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
